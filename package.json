{
  "name": "@lionel-guo/pi-continue",
  "version": "0.1.2",
  "private": false,
  "description": "Recover Pi conversations from aborted and errored assistant replies",
  "type": "module",
  "main": "./extensions/pi-continue.js",
  "exports": {
    ".": "./extensions/pi-continue.js"
  },
  "files": [
    "extensions",
    "test",
    "README.md",
    "GLOSSARY.md",
    "LICENSE",
    "package.json"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LionelGuo/pi-continue.git"
  },
  "bugs": {
    "url": "https://github.com/LionelGuo/pi-continue/issues"
  },
  "homepage": "https://github.com/LionelGuo/pi-continue#readme",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-continue.js"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0"
  },
  "scripts": {
    "test": "node --test"
  }
}
